# Supabase project values from the Project Connect dialog.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Server-only elevated key. Never expose this with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME

# One common pre-race prediction deadline as an ISO-8601 timestamp.
# Example only — replace with the actual configured Sepang race deadline.
NEXT_PUBLIC_PREDICTION_DEADLINE=2026-10-01T08:00:00.000Z
